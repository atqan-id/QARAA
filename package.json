{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "test:adapters": "pnpm -r --filter @atqan/qaraa-adapter-testkit --filter @atqan/qaraa-react --filter @atqan/qaraa-preact --filter @atqan/qaraa-vue --filter @atqan/qaraa-angular --filter @atqan/qaraa-svelte --filter @atqan/qaraa-solid --filter @atqan/qaraa-lit --filter './examples/*' test",
    "test:conformance": "pnpm --filter @atqan/qaraa-protocol test:conformance",
    "test:release": "node --test scripts/audit-boundaries.test.mjs scripts/audit-examples.test.mjs scripts/tarball-smoke.test.mjs scripts/write-esm-wrapper.test.mjs",
    "tarball:smoke": "pnpm build && node scripts/tarball-smoke.mjs",
    "prebenchmark": "pnpm --filter @atqan/qaraa-core build",
    "benchmark": "node benchmarks/src/run-benchmarks.ts",
    "benchmark:smoke": "pnpm benchmark -- --warmups 0 --iterations 1 --output .benchmark-results/smoke.json",
    "audit": "node scripts/audit-repository.mjs && node scripts/audit-boundaries.mjs && node scripts/audit-package.mjs && node scripts/audit-adapters.mjs && node scripts/audit-examples.mjs",
    "examples:build": "pnpm -r --filter './examples/*' build",
    "examples:smoke": "node scripts/smoke-example.mjs"
  },
  "devDependencies": {
    "@angular/core": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/compiler-cli": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@preact/preset-vite": "2.10.6",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-vue": "6.0.8",
    "happy-dom": "20.8.9",
    "astro": "7.2.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "lit": "3.3.3",
    "ng-packagr": "22.1.1",
    "next": "16.3.0",
    "nuxt": "4.5.2",
    "preact": "10.29.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.2",
    "solid-js": "1.9.14",
    "svelte": "5.56.8",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10",
    "vite": "8.2.1",
    "vite-plugin-solid": "2.11.14",
    "vue": "3.5.41"
  }
}
