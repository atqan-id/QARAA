{
  "name": "@atqan/qaraa-benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebenchmark": "pnpm --filter @atqan/qaraa-core build",
    "benchmark": "node src/run-benchmarks.ts",
    "prebenchmark:smoke": "pnpm --filter @atqan/qaraa-core build",
    "benchmark:smoke": "node src/run-benchmarks.ts --warmups 0 --iterations 1",
    "precheck": "pnpm --filter @atqan/qaraa-core build",
    "check": "tsc --noEmit",
    "pretest": "pnpm --filter @atqan/qaraa-core build",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@atqan/qaraa-core": "workspace:*",
    "ajv": "8.20.0"
  }
}
