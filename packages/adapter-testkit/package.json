{
  "name": "@atqan/qaraa-adapter-testkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" } },
  "scripts": { "build": "tsdown --no-config src/index.ts --format esm --dts --out-dir dist --clean --logLevel error --deps.never-bundle @atqan/qaraa-client --deps.never-bundle @atqan/qaraa-core", "check": "tsc --noEmit && pnpm run build", "test": "node --test test/*.test.ts" },
  "dependencies": { "@atqan/qaraa-client": "workspace:*", "@atqan/qaraa-core": "workspace:*" }
}
