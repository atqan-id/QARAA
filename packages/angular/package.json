{
  "name": "@atqan/qaraa-angular",
  "version": "0.1.0",
  "description": "Qur’an recitation alignment library adapter.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "module": "./dist/fesm2022/atqan-qaraa-angular.mjs",
  "types": "./dist/types/atqan-qaraa-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/atqan-qaraa-angular.d.ts",
      "default": "./dist/fesm2022/atqan-qaraa-angular.mjs"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json && ngc -p tsconfig.full.json && node ../../scripts/write-angular-full-package.mjs",
    "check": "ngc -p tsconfig.lib.json --noEmit && pnpm run build && ngc -p test/aot/tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@angular/core": ">=20.3.27 <23",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "dependencies": {
    "@atqan/qaraa-client": "workspace:*",
    "@atqan/qaraa-core": "workspace:*",
    "tslib": "^2.8.1"
  }
}
